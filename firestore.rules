rules_version = '2';

// CRM CANI Café — reglas de Firestore (versionadas en el repo).
// Política HT-001: solo usuarios autenticados cuyo documento users/{uid} tenga active == true
// pueden leer y escribir. Todo lo que no esté listado aquí queda denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Gabriel: plataforma, acceso, contactos y comunicaciones
    match /users/{userId} {
      allow read, write: if isActiveUser();
    }
    // HU-101 y HU-106: índice usuario → cuenta ({uid, email}); el id es el usuario normalizado.
    // Sin sesión solo se lee UN documento por su id exacto (get): hace falta para ingresar y para recuperar la
    // contraseña. Nadie sin sesión puede listar usuarios ni escribir. Riesgo aceptado: quien conozca un usuario
    // puede ver el correo de esa cuenta (la pantalla de recuperación ya muestra parte de él).
    match /usernames/{username} {
      allow get: if true;
      allow list: if isActiveUser();
      allow write: if isActiveUser();
    }
    // HU-107: último enlace de recuperación pedido por cada usuario ({rid, requestedAt, used}).
    // Sin sesión (pantallas "Recuperar contraseña" y "Nueva contraseña"):
    //   - se lee por id exacto, para saber si el enlace sigue sirviendo;
    //   - se registra un enlace nuevo SOLO para un usuario que existe, con la hora del servidor y sin usar;
    //   - se marca como usado sin cambiar nada más.
    // No da acceso a nada: cambiar la contraseña exige además el código que Firebase manda al correo de la cuenta.
    // Riesgo aceptado: quien conozca un usuario puede anular su enlace pendiente pidiendo otro (se le envía otro correo).
    match /passwordResets/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update: if exists(/databases/$(database)/documents/usernames/$(username))
        && (isNewResetRequest(request.resource.data) || isResetMarkedUsed());
      allow delete: if false;
    }
    function isNewResetRequest(data) {
      return data.keys().hasOnly(['rid', 'requestedAt', 'used'])
        && data.keys().hasAll(['rid', 'requestedAt', 'used'])
        && data.rid is string
        && data.rid.matches('^[0-9a-f]{32}$')
        && data.requestedAt == request.time
        && data.used == false;
    }
    function isResetMarkedUsed() {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && resource.data.used == false
        && request.resource.data.used == true;
    }
    match /contacts/{contactId} {
      allow read, write: if isActiveUser();
    }
    // HU-211: una comunicación se registra y queda como historial: no se puede editar ni eliminar.
    // Se valida lo mismo que en el formulario: contacto existente, posible venta (HU-212), fecha no futura,
    // medio de la lista ("otro" con su texto), nota de 1 a 1000 caracteres, y que la registre el usuario con sesión.
    function isValidCommunication(data) {
      return data.keys().hasOnly(['contactId', 'saleId', 'appliesToAllSales', 'date', 'medium', 'otherMedium', 'note', 'source', 'userId', 'createdAt'])
        && data.keys().hasAll(['contactId', 'saleId', 'appliesToAllSales', 'date', 'medium', 'otherMedium', 'note', 'source', 'userId', 'createdAt'])
        && data.contactId is string
        && exists(/databases/$(database)/documents/contacts/$(data.contactId))
        // HU-212: corresponde a "Todas sus posibles ventas" o a una posible venta abierta del mismo contacto.
        && data.appliesToAllSales is bool
        && (data.appliesToAllSales
              ? data.saleId == null
              : (data.saleId is string
                  && exists(/databases/$(database)/documents/sales/$(data.saleId))
                  && get(/databases/$(database)/documents/sales/$(data.saleId)).data.contactId == data.contactId
                  && get(/databases/$(database)/documents/sales/$(data.saleId)).data.stage
                       in ['nuevo_interesado', 'contactado', 'cotizacion_enviada', 'en_negociacion']))
        && data.date is timestamp
        && data.date <= request.time
        && data.medium in ['llamada', 'whatsapp', 'correo', 'visita', 'otro']
        && (data.medium == 'otro'
              ? (data.otherMedium is string && data.otherMedium.trim().size() > 0 && data.otherMedium.size() <= 50)
              : data.otherMedium == null)
        && data.note is string
        && data.note.trim().size() > 0
        && data.note.size() <= 1000
        // HU-213: registrada a mano, siempre por el usuario con sesión. Las del formulario web van por
        // isValidFormCommunication.
        && data.source == 'usuario'
        && data.userId == request.auth.uid
        && data.createdAt == request.time;
    }

    // HU-502 y HU-503: comunicación de un formulario del sitio web. La escribe el procesamiento del sistema interno, en
    // el navegador del administrador con su sesión (CC-01, costo 0; no hay Admin SDK ni funciones de servidor), en el
    // MISMO lote que crea o actualiza el contacto. Por eso el contacto se comprueba con existsAfter(): con una persona
    // nueva todavía no existe antes del lote y exists() lo rechazaría.
    // - Sin usuario ("Sistema (formulario web)"), medio "Formulario web" y para "Todas sus posibles ventas".
    // - date = fecha y hora exactas del envío (no futura).
    // - note: mensaje (o "Sin mensaje"), productos con sus cantidades (HU-502, criterio 4) y diferencias; hasta 8000.
    // - products: de 1 a 72 (las reglas no pueden revisar cada uno; lo hace el procesamiento).
    function isValidFormCommunication(data) {
      return data.keys().hasOnly(['contactId', 'saleId', 'appliesToAllSales', 'date', 'medium', 'otherMedium', 'note', 'source', 'userId', 'createdAt', 'products'])
        && data.keys().hasAll(['contactId', 'saleId', 'appliesToAllSales', 'date', 'medium', 'otherMedium', 'note', 'source', 'userId', 'createdAt', 'products'])
        && data.contactId is string
        && existsAfter(/databases/$(database)/documents/contacts/$(data.contactId))
        && data.source == 'formulario_web'
        && data.medium == 'formulario_web'
        && data.userId == null
        && data.otherMedium == null
        && data.saleId == null
        && data.appliesToAllSales == true
        && data.date is timestamp
        && data.date <= request.time
        && data.note is string
        && data.note.trim().size() > 0
        && data.note.size() <= 8000
        && data.products is list
        && data.products.size() >= 1
        && data.products.size() <= 72
        && data.createdAt == request.time;
    }

    match /communications/{communicationId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && (isValidCommunication(request.resource.data) || isValidFormCommunication(request.resource.data));
      allow update, delete: if false;
    }

    // Dylan: productos, ventas, etapas y avisos
    match /products/{productId} {
      // Sitio público (HU-402): cualquiera puede leer los productos activos, nunca los inactivos. Una consulta solo
      // se permite si filtra con where('active', '==', true); sin ese filtro se deniega aunque haya productos activos.
      allow read: if isActiveUser() || resource.data.active == true;
      allow write: if isActiveUser();
    }
    match /sales/{saleId} {
      allow read, write: if isActiveUser();
    }
    match /saleProducts/{saleProductId} {
      allow read, write: if isActiveUser();
    }
    match /stageHistory/{stageHistoryId} {
      allow read, write: if isActiveUser();
    }

    // Formulario del sitio público. Contrato v3 confirmado (docs-local/CONTRATO_FORMULARIO.md).
    // Creación (HU-405, Dylan): validación de Dylan sin cambios.
    // Lectura y procesamiento (HU-502 a HU-504, Gabriel, E5-020.1): solo con sesión activa.
    // Formulario del sitio público (HU-405): cualquiera puede CREAR una solicitud válida; sin sesión nadie la lee, la
    // cambia ni la borra. Un reintento sobre un documento que ya existe cuenta como "update" y se rechaza.
    // Contrato: src/shared/types/formRequest.ts.
    // Límite conocido: las reglas no tienen ciclos y evalúan como máximo unas 1000 expresiones por petición, así que no
    // alcanzan para revisar uno por uno hasta 72 productos (se probó: con 10 o más se pasa del tope y rechaza
    // solicitudes válidas). Aquí se revisa que `interests` sea una lista de 1 a 72; el id y la cantidad (1 a 9999) de cada
    // producto los revisa el formulario (HU-501) y debe revisarlos el procesamiento del sistema interno, que además
    // comprueba que cada producto exista.
    function isValidFormRequest(data) {
      return data.keys().hasOnly(['fullName', 'email', 'phoneCountry', 'phoneNumber', 'interests', 'message', 'submittedAt', 'processed'])
        && data.keys().hasAll(['fullName', 'email', 'phoneCountry', 'phoneNumber', 'interests', 'message', 'submittedAt', 'processed'])
        && data.fullName is string
        && data.fullName.trim().size() > 0
        && data.fullName.size() <= 100
        && data.email is string
        && data.email.size() <= 100
        && data.email == data.email.lower()
        // nombre@dominio.com, igual que el formulario (en el texto de las reglas la barra va doble: \\s = espacio en blanco).
        && data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$')
        // Teléfono opcional: los dos null, o país (ISO de 2 letras) y número solo con dígitos (8 en Costa Rica, 6 a 14 en otros).
        && ((data.phoneCountry == null && data.phoneNumber == null)
            || (data.phoneCountry is string
                && data.phoneCountry.matches('^[A-Z]{2}$')
                && data.phoneNumber is string
                && (data.phoneCountry == 'CR'
                      ? data.phoneNumber.matches('^[0-9]{8}$')
                      : data.phoneNumber.matches('^[0-9]{6,14}$'))))
        && data.interests is list
        && data.interests.size() >= 1
        && data.interests.size() <= 72
        && (data.message == null || (data.message is string && data.message.size() > 0 && data.message.size() <= 1000))
        && data.submittedAt == request.time
        && data.processed == false;
    }

    // HU-502 y HU-503: el procesamiento del sistema interno (en el navegador del administrador, CC-01) solo puede tocar
    // los campos de procesamiento; lo que envió la persona no se cambia. Una solicitud ya procesada no vuelve a cambiar.
    // - Reclamo (evita el doble procesamiento): claimedAt = hora del servidor y claimedBy = quien procesa.
    // - Cierre: processed = true con processedAt = hora del servidor y outcome; contactId si creó o actualizó,
    //   error (hasta 500) si se rechazó.
    function isValidFormRequestProcessing(before, after) {
      let changed = after.diff(before).affectedKeys();
      return before.processed == false
        && changed.hasOnly(['processed', 'processedAt', 'contactId', 'outcome', 'error', 'claimedAt', 'claimedBy'])
        && after.processed is bool
        && (!changed.hasAny(['claimedAt']) || after.claimedAt == request.time)
        && (!changed.hasAny(['claimedBy']) || after.claimedBy == request.auth.uid)
        && (!changed.hasAny(['processedAt']) || after.processedAt == request.time)
        && (!changed.hasAny(['outcome']) || after.outcome in ['created', 'updated', 'rejected'])
        && (!changed.hasAny(['contactId']) || (after.contactId is string && after.contactId.size() > 0))
        && (!changed.hasAny(['error']) || (after.error is string && after.error.size() > 0 && after.error.size() <= 500))
        // Cerrar exige el resultado completo: rechazada con su error, creada o actualizada con su contacto.
        && (after.processed == false
              || (after.processedAt == request.time
                  && (after.outcome == 'rejected'
                        ? after.get('error', null) is string
                        : (after.outcome in ['created', 'updated'] && after.get('contactId', null) is string))));
    }

    match /formRequests/{requestId} {
      allow create: if isValidFormRequest(request.resource.data);
      // Sin sesión, nada. Con sesión activa se lee y se procesa; nadie borra (las procesadas se conservan).
      allow read: if isActiveUser();
      allow update: if isActiveUser() && isValidFormRequestProcessing(resource.data, request.resource.data);
      allow delete: if false;
    }
  }
}
