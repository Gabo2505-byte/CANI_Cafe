# Plantilla de variables de entorno. NO contiene secretos.
#
# - Desarrollo y pruebas usan .env.development y .env.test (proyectos demo-*,
#   solo emuladores). Esos archivos se versionan porque no tienen datos sensibles.
# - Para apuntar a un proyecto real de Firebase, copiá este archivo a
#   .env.production.local (ignorado por git) y completá los valores desde
#   Consola de Firebase > Configuración del proyecto > Tus apps > Web.
#   No uses .env.local: Vite lo carga también en desarrollo y pisaría la config demo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = conectar el frontend a los emuladores locales
VITE_USE_EMULATORS=false
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Solo scripts de Node (seed / pruebas). Vite no expone variables sin prefijo VITE_. ---
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Contraseña del administrador de prueba que crea el seed (solo emulador)
SEED_ADMIN_PASSWORD=
