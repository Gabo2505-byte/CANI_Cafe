# Desarrollo local contra Firebase Emulator Suite. Sin secretos: proyecto "demo-*".
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cani-crm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cani-crm
VITE_FIREBASE_STORAGE_BUCKET=demo-cani-crm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

VITE_USE_EMULATORS=true
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Solo scripts de Node (seed)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
